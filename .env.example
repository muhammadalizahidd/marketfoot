# Public Supabase project connection (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only: never expose this value through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Exact public app origin. Required in production for Google OAuth and email-confirmation callbacks.
APP_URL=https://app.example.com

# Optional database connection for local migration tooling only. Do not expose it.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
